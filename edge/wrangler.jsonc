{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiops-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "observability": { "enabled": true },
  // The React app. API, runner and health paths go to the Worker first; every other path is a
  // static file, with index.html for client-side routes.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/runner/*", "/admin/*", "/healthz"]
  },
  // Every minute: if any run is unfinished, wake aiopsd so it keeps advancing after the browser
  // closes or the container restarts. Idle accounts cost nothing.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "META_BASE_URL": "https://api.meta.ai/v1",
    // Model for the observer and experimenter roles; needs the META_API_KEY secret too. Without
    // both, aiopsd uses the replay provider and labels runs `replay`. IDs available to the key
    // are listed by the Meta contract workflow (GET /v1/models); muse-spark-1.3 passed its
    // contract test (tool round trip and JSON-schema answer).
    "META_MODEL": "muse-spark-1.3",
    // Artifacts above this many bytes go to R2 instead of staying inline in D1. 4 KB sends every
    // baseline and trial report (5-7 KB) through R2, so the relay is exercised on every run.
    "AIOPS_INLINE_LIMIT": "4096",
    // 24/7 operation (docs/operations.md). A measurement too noisy to judge is tried again later,
    // up to 3 times, 20, 40 and 60 minutes on.
    "AIOPS_NOISE_RETRIES": "3",
    "AIOPS_NOISE_RETRY_MINUTES": "20",
    // Per UTC day: past the token budget a run stops before calling the model; past the run cap
    // new runs are refused with 429. A Meta run uses about 40-70K tokens.
    "AIOPS_DAILY_TOKEN_LIMIT": "1500000",
    "AIOPS_DAILY_RUN_LIMIT": "30",
    // One scheduled run per UTC day at this time (02:00 in Korea). "" turns the schedule off.
    "AIOPS_DAILY_RUN_UTC": "05:50",
    // Links in notifications. The webhook itself is the NOTIFY_WEBHOOK_URL secret.
    "AIOPS_PUBLIC_URL": "https://aiops-edge.yh9365.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiops-control",
      "database_id": "40be013f-ab7b-40eb-889a-40454179225f",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "aiops-artifacts" }],
  "containers": [
    {
      "class_name": "AiopsdContainer",
      "image": "../deploy/Dockerfile.aiopsd",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 1
    },
    {
      "class_name": "RunnerContainer",
      "image": "../deploy/Dockerfile.runner",
      "image_build_context": "..",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "AIOPSD", "class_name": "AiopsdContainer" },
      { "name": "RUNNER", "class_name": "RunnerContainer" }
    ],
    // Adopt new Worker code at once. By default (since 2026-10-30) an active Durable Object keeps
    // its old code for up to 5 minutes; the container classes here hold no in-flight work worth
    // waiting for, and the deploy restarts aiopsd right after, which needs the new environment.
    "code_update_strategy": { "mode": "immediate" }
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunnerContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["AiopsdContainer"] }
  ]
}
