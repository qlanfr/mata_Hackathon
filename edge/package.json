{
  "name": "aiops-edge",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "build:web": "npm --prefix ../web ci && npm --prefix ../web run build"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  }
}
